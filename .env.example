# =============================================================================
# NeuroForge - Production Environment Configuration Template
# =============================================================================
# NOTE: Copy this file to .env and replace placeholder values before deployment.
# NEVER commit real passwords or production JWT secrets to source control.

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/neuroforge?createDatabaseIfNotExist=false&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=neuroforge_user
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD
JPA_DDL_AUTO=validate

# Security & JWT (Must be at least 32 characters / 256 bits for HMAC-SHA256)
JWT_SECRET=YOUR_MINIMUM_32_CHARACTER_CRYPTOGRAPHIC_JWT_SECRET_KEY
JWT_EXPIRATION_MS=86400000

# Application Features & Security Gates
DEMO_MODE_ENABLED=false
SEED_SAMPLE_DATA=false

# CORS (Comma-separated list of allowed frontend origins, e.g. https://app.neuroforge.io)
CORS_ALLOWED_ORIGINS=https://app.neuroforge.io

# AI Assistant Settings (offline | openai | gemini)
AI_PROVIDER=offline
AI_API_KEY=
